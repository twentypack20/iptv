  "exclude_name_contains": [
    "adult",
    "xxx"
  ],
  "category_rules": [
    {
      "group": "Live TV - Weather",
      "contains": ["weather", "forecast"]
    },
    {
      "group": "Live TV - News",
      "contains": ["news", "opinion", "current affairs"]
    },
    {
      "group": "Live TV - Sports",
      "contains": ["sport", "football", "soccer", "basketball", "baseball", "hockey", "golf", "racing", "outdoors"]
    },
    {
      "group": "Live TV - Business",
      "contains": ["business", "finance", "markets", "shopping"]
    },
    {
      "group": "Live TV - Local / Public",
      "contains": ["local", "public", "legislative", "government", "community"]
    },
    {
      "group": "Live TV - Movies",
      "contains": ["movie", "cinema", "film"]
    },
    {
      "group": "Live TV - Kids / Family",
      "contains": ["kids", "children", "family", "animation", "animated"]
    },
    {
      "group": "Live TV - Documentary / Education",
      "contains": ["documentary", "education", "science", "history", "nature", "animals", "culture"]
    },
    {
      "group": "Live TV - Lifestyle",
      "contains": ["lifestyle", "food", "cooking", "home", "travel", "reality", "relax"]
    },
    {
      "group": "Live TV - Music",
      "contains": ["music"]
    },
    {
      "group": "Live TV - Religious",
      "contains": ["religious", "faith", "christian"]
    },
    {
      "group": "Live TV - Series / TV",
      "contains": ["series", "classic tv", "comedy", "drama", "crime", "entertainment"]
    }
  ],
  "fallback_category": "Live TV - Other",
  "smart_selection": {
    "enabled": true,
    "epg_similarity_threshold": 0.8,
    "epg_minimum_titles": 4,
    "renamed_epg_similarity_threshold": 0.9,
    "renamed_epg_minimum_titles": 6,
    "epg_candidate_min_shared_titles": 4,
    "epg_candidate_max_title_frequency": 12,
    "strip_name_suffixes": ["hd", "fhd", "uhd", "4k", "1080p", "720p", "fast"],
    "local_network_names": ["ABC", "CBS", "NBC", "FOX", "PBS", "CW", "The CW", "Telemundo", "Univision", "MyNetworkTV"],
    "local_keywords": [
      "local",
      "city",
      "county",
      "regional",
      "miami",
      "tampa",
      "orlando",
      "jacksonville",
      "atlanta",
